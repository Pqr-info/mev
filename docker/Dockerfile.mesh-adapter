# MEV Protocol — Mesh Citizen Shell Adapter
#
# Multi-stage build for Go mesh-adapter service

FROM golang:alpine as builder

WORKDIR /build

RUN apk add --no-cache gcc musl-dev

# Copy the entire module content (needed since mesh-adapter does not have its own go.mod)
COPY . .

RUN CGO_ENABLED=0 go build -ldflags="-w -s" -o mesh-adapter ./mesh-adapter

# Stage 2: Runtime
FROM alpine:3.19

WORKDIR /app

RUN apk add --no-cache ca-certificates

COPY --from=builder /build/mesh-adapter /app/

RUN adduser -D -u 1000 mev
USER mev

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD pgrep mesh-adapter || exit 1

ENTRYPOINT ["/app/mesh-adapter"]
